# HakiOS fragment: the Xiaomi 11 Lite 5G NE (lisa) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="lisa"
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
CONFIG_HAKIOS_ADRENO=y
# CONFIG_HAKIOS_HAPTIC is not set

# The touch screen: a Goodix "Berlin" (gt9897t) on SPI serial engine 13 (spi@a94000), the same engine, pins (52-55),
# reset (105) and interrupt (81) as the POCO X5 Pro, read from the phone's device tree (xiaomi,k9-spi). Two things are
# this phone's and go to the driver as boot-arguments: its analog supply is the PMIC rail ldoc7 (PM8350C L7, 3.0 V)
# through RPMh, not a GPIO; and it carries only Goodix, so the controller straps (GPIO96/68) are not read.
CONFIG_HAKIOS_GOODIX=y
CONFIG_TOUCH_AVDD_LDO="ldoc7"
CONFIG_TOUCH_AVDD_MV=3000
CONFIG_TOUCH_CHIP="goodix"
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_WIFI is not set
CONFIG_TOUCHSCREEN=y
CONFIG_GPU=y
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
CONFIG_FIRMWARE="device"

From 98db8f8239d3ab1f7aa63d51c642d3aa6d705289 Mon Sep 17 00:00:00 2001
From: Mateus Seiboth <mateusseiboth12@gmail.com>
Date: Sun, 8 Nov 2026 16:39:20 -0400
Subject: [PATCH 2/4] mk-mesa: find the SDK's zlib through pkg-config for the
 cross build

The iPhoneOS SDK ships zlib (and other libraries) as .tbd stubs with no pkg-config
.pc file, and meson's "system" detection does not recognise a .tbd as a library,
so zlib is not found and the Mesa build stops. Enable a real pkg-config in the
cross file and drop a zlib.pc pointing at the SDK, so meson finds it (its first
method). With this, and the ld64-lld wrapper reading .tbd stubs, Mesa 25.0.7
(softpipe + freedreno) builds as libOSMesa.8.dylib for GL=1 on the Adreno.
---
 tools/mk-mesa.sh | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/tools/mk-mesa.sh b/tools/mk-mesa.sh
index 045e37b..bcb370b 100755
--- a/tools/mk-mesa.sh
+++ b/tools/mk-mesa.sh
@@ -84,7 +84,7 @@ objc = ['$CC', '-arch', 'arm64', '-isysroot', '$SDK']
 ar = 'llvm-ar'
 ranlib = 'llvm-ranlib'
 strip = 'llvm-strip'
-pkg-config = 'false'
+pkg-config = 'pkg-config'
 
 [host_machine]
 system = 'darwin'
@@ -96,6 +96,24 @@ endian = 'little'
 [properties]
 needs_exe_wrapper = true
 INI
+
+# The SDK ships zlib (and other libraries) as .tbd stubs without a pkg-config .pc, and meson's
+# "system" detection does not recognise a .tbd as a library file, so it never finds them. Give it
+# a .pc per such library, pointing at the SDK, and let meson find them through pkg-config (its first
+# method). The paths are the SDK's own, absolute, so PKG_CONFIG_SYSROOT_DIR stays unset.
+mkdir -p pkgconfig
+cat > pkgconfig/zlib.pc <<PC
+prefix=$SDK/usr
+libdir=\${prefix}/lib
+includedir=\${prefix}/include
+Name: zlib
+Description: zlib compression library (SDK stub)
+Version: 1.2.11
+Libs: -L\${libdir} -lz
+Cflags: -I\${includedir}
+PC
+export PKG_CONFIG_LIBDIR=$B/pkgconfig
+unset PKG_CONFIG_SYSROOT_DIR PKG_CONFIG_PATH
 DRIVERS=${DRIVERS:-softpipe,freedreno}
 BUILD=build-${DRIVERS//,/-}
 [ -f $BUILD/build.ninja ] || meson setup $BUILD mesa-$VERSION --cross-file cross.ini --wrap-mode=nofallback \
-- 

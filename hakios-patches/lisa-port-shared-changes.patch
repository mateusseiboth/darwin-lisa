From 3434bb74e9643625fec05e490a12fe38411712c6 Mon Sep 17 00:00:00 2001
From: Mateus Seiboth <mateusseiboth12@gmail.com>
Date: Sun, 8 Nov 2026 22:39:35 -0400
Subject: [PATCH 4/4] goodix: calibrate the gt9897 to the panel resolution
 (1080x2400)

The gt9897's ic-info carries a coordinate field ten times the panel (10800x24000
for lisa's 1080x2400 screen), and the driver was taking it as the touch maximum,
so iOS mapped every touch into a tenth of the screen: taps missed their target and
a full-screen drag moved an element only to ~10%. postmarketOS's Goodix driver
reports 1079x2399. For variant A, use the panel resolution and skip the ic-info
override (which reads the 10x field at this offset); variant D is unchanged.
---
 drivers/input/hakios.goodix.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/input/hakios.goodix.c b/drivers/input/hakios.goodix.c
index 4dae5a0..086b8ef 100644
--- a/drivers/input/hakios.goodix.c
+++ b/drivers/input/hakios.goodix.c
@@ -650,6 +650,7 @@ static uint32_t touch_address, command_address;
 static uint32_t goodix_fw_version_addr = GOODIX_FW_VERSION_D;
 static uint32_t goodix_ic_info_addr = GOODIX_IC_INFO_D;
 static uint32_t goodix_read_dummy = 3;
+static bool goodix_variant_a;            /* gt9897: its ic-info reports a 10x coordinate field, see max_x below */
 static const char *report_rate = "240";        /* what the status line says (touch_rate=480) */
 static uint32_t max_x = 10800, max_y = 24000;   /* the device tree's; the chip may say otherwise */
 
@@ -808,7 +809,8 @@ goodix_probe(bool verbose)
 	if (offset + 122 + 20 + 2 <= length) {
 		uint16_t x = le16(info + offset + 122 + 16), y = le16(info + offset + 122 + 18);
 
-		if (x && y) {
+		/* variant A keeps the panel resolution set above: at this offset it reads the 10x field. */
+		if (x && y && !goodix_variant_a) {
 			max_x = x;
 			max_y = y;
 		}
@@ -1606,6 +1608,12 @@ goodix_thread(__unused void *parameter, __unused wait_result_t result)
 			goodix_fw_version_addr = GOODIX_FW_VERSION_A;
 			goodix_ic_info_addr = GOODIX_IC_INFO_A;
 			goodix_read_dummy = 4;
+			goodix_variant_a = true;
+			/* the gt9897's ic-info carries a coordinate field ten times the panel (10800x24000 for
+			 * lisa's 1080x2400); postmarketOS's goodix driver reports 1079x2399. Use the panel's own
+			 * resolution and do not let the ic-info parse below overwrite it with the 10x value. */
+			max_x = 1080;
+			max_y = 2400;
 		}
 		/* boot-arg touch_delay_ms: wait before the probe so its log survives the early ring-buffer churn. */
 		if (PE_parse_boot_argn("touch_delay_ms", &delay_ms, sizeof(delay_ms)) && delay_ms) {

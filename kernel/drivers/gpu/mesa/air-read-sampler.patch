+/* air.get_read_sampler(): AIR 2.8's handle for the sampler a read takes.
+ *
+ * iOS 26's QuartzCore (AIR 2.8.4, 16 of its 189 modules) calls it once per
+ * function and passes the result as the second operand of every
+ * air.read_texture_* there:
+ *   %s = call ptr addrspace(2) @air.get_read_sampler()
+ *   call { <4 x half>, i8 } @air.read_texture_2d.v4f16(ptr as(1) %tex, ptr as(2) %s,
+ *        <2 x i32> %coord, <2 x i32> zeroinitializer, i32 %lod, i32 0)
+ * A read fetches by integer coordinate and filters nothing, so nothing of a
+ * sampler state reaches the instruction: the handle only has to be a sampler
+ * so that texture_op can recognise and skip it. AIR_READ_SAMPLER is no slot of
+ * the pipeline's and never becomes a sampler_index.
+ */
+#define AIR_READ_SAMPLER (~0u)
+
+static bool
+read_sampler_op(struct air_ctx *c, const struct air_inst *in)
+{
+   struct air_ptr p = { .class = AIR_PTR_SAMPLER, .binding = AIR_READ_SAMPLER };
+   air_set(c, &in->base, air_val_ptr(c, p));
+   return true;
+}

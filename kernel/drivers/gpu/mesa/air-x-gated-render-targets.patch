+/* darwin-lisa: is the entry point's render target `field` one its function-constant
+ * predicate leaves out? Metal's `[[function_constant(p)]]` on a member of the returned struct makes
+ * the member absent when p is false: the target is not written and keeps what it holds.
+ * Apple's compiler still fills the member (CoreAnimation's uber shader returns NaN in the
+ * colour targets a specialisation does not own), so storing it anyway overwrites the
+ * target -- the SDF prepass of a rounded clip wrote NaN over the surface (a black square)
+ * and the content draws wrote NaN over the clip's memoryless SDF (the clip lost).
+ * The predicate is a global the static initialiser computes from the constants; one it
+ * did not decide is stored, with a note, as before. */
+static bool
+output_left_out(struct air_ctx *c, unsigned field)
+{
+   const struct air_value *p = c->outputs[field].pred;
+   if (!p)
+      return false;
+   struct air_global_plan *plan = foldable_global_plan(c, p);
+   if (!plan || !plan->known) {
+      air_note(c, "output %u is gated by a function-constant predicate the static "
+                  "initialiser did not decide: written unconditionally", field);
+      return false;
+   }
+   return plan->bits == 0;
+}

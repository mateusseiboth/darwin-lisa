+// darwin-lisa: a framebuffer fetch that only blends, handed to the blend unit (fetchToBlend below).
+//
+// CoreAnimation's uber shader reads its target on every draw (fc_framebuffer_fetch) and blends in the shader, with
+// the pipeline's blending off. In sysmem the fetch costs a full-screen draw twice what the blend unit costs for the
+// same picture: the probe's "full-screen cost, 4 draws" is 3.7 ms with no fetch and 7.1 ms with it (1.78 ms a draw),
+// and "GMEM cost: 8 full-screen blended draws" 7.3 ms with the blend unit (0.91 ms a draw): the RB reads the
+// destination through the colour cache, the fetch through the texture unit after a CCU flush. The heavy passes of the
+// Settings scroll and the cover sheet are 8-9 such draws at ~1.9 ms each.
+//
+// When colour 0 is, channel by channel, A + B * dst (A and B free of the destination, dst the same channel of the
+// target), the stage is rewritten to hand A over as its colour and the blend unit does the rest: with B the same
+// value 1 - A.a on every channel, the blend ONE, ONE_MINUS_SRC_ALPHA (source-over, premultiplied); else B goes out as
+// the second source and the blend is ONE, SRC1_COLOR / ONE, SRC1_ALPHA (dual source). A and B are built from the
+// shader's own expression with dst set to 0 and to its derivative, so nothing is approximated but the rounding of
+// the last multiply-add, which the blend unit now does instead of the shader.
+//
+// Refused (the stage is left as it was): a read of another target, a destination value that reaches anything but
+// colour 0 (a branch, a discard, a memory store, a texture coordinate, another output), a product or a min/max of
+// two destination terms, a channel mixed into another (non-separable blend modes), colour 0 stored more than once,
+// and for the dual-source form any other colour output.
+namespace fetchblend {
+
+struct Lin {
+    uint8_t kind = 0;   // 0 free of the destination, 1 a + b * dst.ch, 2 anything else
+    uint8_t ch = 0;
+};
+struct Built {
+    nir_def* a = nullptr;   // nullptr: 0
+    nir_def* b = nullptr;
+};
+using Key = std::pair<nir_def*, unsigned>;
+
+struct Ctx {
+    std::set<nir_def*> fetches;   // load_output fbfetch of colour 0
+    std::set<nir_def*> tainted;   // every def a fetch reaches
+    std::map<Key, Lin> lin;
+    std::map<Key, Built> built;
+    nir_builder* b = nullptr;
+};
+
+Lin merge(Lin x, Lin y) {
+    if (x.kind == 2 || y.kind == 2) return {2, 0};
+    if (x.kind == 0) return y;
+    if (y.kind == 0) return x;
+    return x.ch == y.ch ? x : Lin{2, 0};
+}
+
+bool isConversion(nir_op op) {
+    return op == nir_op_f2f16 || op == nir_op_f2f32 || op == nir_op_f2fmp || op == nir_op_f2f16_rtne || op == nir_op_f2f16_rtz;
+}
+
+Lin analyze(Ctx& c, nir_scalar s) {
+    s = nir_scalar_chase_movs(s);
+    if (c.fetches.count(s.def) != 0) return {1, uint8_t(s.comp)};
+    if (c.tainted.count(s.def) == 0) return {0, 0};
+    const Key k{s.def, s.comp};
+    auto it = c.lin.find(k);
+    if (it != c.lin.end()) return it->second;
+    Lin r{2, 0};
+    if (nir_scalar_is_alu(s)) {
+        auto src = [&](unsigned i) { return analyze(c, nir_scalar_chase_alu_src(s, i)); };
+        const nir_op op = nir_scalar_alu_op(s);
+        switch (op) {
+        case nir_op_fadd:
+        case nir_op_fsub:
+            r = merge(src(0), src(1));
+            break;
+        case nir_op_fneg:
+            r = src(0);
+            break;
+        case nir_op_fmul: {
+            const Lin x = src(0), y = src(1);
+            r = x.kind == 0 || y.kind == 0 ? merge(x, y) : Lin{2, 0};
+            break;
+        }
+        case nir_op_ffma: {
+            const Lin x = src(0), y = src(1);
+            r = merge(x.kind == 0 || y.kind == 0 ? merge(x, y) : Lin{2, 0}, src(2));
+            break;
+        }
+        case nir_op_bcsel:
+            r = src(0).kind == 0 ? merge(src(1), src(2)) : Lin{2, 0};
+            break;
+        default:
+            if (isConversion(op)) r = src(0);
+            break;
+        }
+    }
+    c.lin[k] = r;
+    return r;
+}
+
+nir_def* scalarOf(Ctx& c, nir_scalar s) { return nir_channel(c.b, s.def, s.comp); }
+nir_def* zero(Ctx& c, unsigned bits) { return nir_imm_floatN_t(c.b, 0.0, bits); }
+nir_def* add(Ctx& c, nir_def* x, nir_def* y) { return x == nullptr ? y : y == nullptr ? x : nir_fadd(c.b, x, y); }
+nir_def* sub(Ctx& c, nir_def* x, nir_def* y) { return y == nullptr ? x : x == nullptr ? nir_fneg(c.b, y) : nir_fsub(c.b, x, y); }
+bool isConstOf(nir_def* d, double v) {
+    if (d == nullptr) return false;
+    const nir_scalar s = nir_scalar_chase_movs(nir_get_scalar(d, 0));
+    return nir_scalar_is_const(s) && nir_scalar_as_float(s) == v;
+}
+nir_def* mul(Ctx& c, nir_def* f, nir_def* y) { return y == nullptr ? nullptr : isConstOf(y, 1.0) ? f : nir_fmul(c.b, f, y); }
+nir_def* fma(Ctx& c, nir_def* f, nir_def* y, nir_def* z) { return y == nullptr ? z : add(c, mul(c, f, y), z); }
+// a conversion of a built value; of the constant 1 (the destination's own B), the constant in the new size
+nir_def* conv(Ctx& c, nir_op op, nir_def* x) {
+    if (x == nullptr) return nullptr;
+    const nir_scalar s = nir_scalar_chase_movs(nir_get_scalar(x, 0));
+    if (nir_scalar_is_const(s)) return nir_imm_floatN_t(c.b, nir_scalar_as_float(s), nir_alu_type_get_type_size(nir_op_infos[op].output_type) ? nir_alu_type_get_type_size(nir_op_infos[op].output_type) : 16);
+    return nir_build_alu1(c.b, op, x);
+}
+
+Built build(Ctx& c, nir_scalar s) {
+    s = nir_scalar_chase_movs(s);
+    if (c.fetches.count(s.def) != 0) return {nullptr, nir_imm_floatN_t(c.b, 1.0, s.def->bit_size)};
+    if (analyze(c, s).kind == 0) return {scalarOf(c, s), nullptr};
+    const Key k{s.def, s.comp};
+    auto it = c.built.find(k);
+    if (it != c.built.end()) return it->second;
+    auto at = [&](unsigned i) { return nir_scalar_chase_alu_src(s, i); };
+    const nir_op op = nir_scalar_alu_op(s);
+    Built r;
+    switch (op) {
+    case nir_op_fadd: {
+        const Built x = build(c, at(0)), y = build(c, at(1));
+        r = {add(c, x.a, y.a), add(c, x.b, y.b)};
+        break;
+    }
+    case nir_op_fsub: {
+        const Built x = build(c, at(0)), y = build(c, at(1));
+        r = {sub(c, x.a, y.a), sub(c, x.b, y.b)};
+        break;
+    }
+    case nir_op_fneg: {
+        const Built x = build(c, at(0));
+        r = {x.a ? nir_fneg(c.b, x.a) : nullptr, x.b ? nir_fneg(c.b, x.b) : nullptr};
+        break;
+    }
+    case nir_op_fmul:
+    case nir_op_ffma: {
+        nir_scalar f = at(0), y = at(1);
+        if (analyze(c, f).kind != 0) std::swap(f, y);
+        const Built yb = build(c, y);
+        nir_def* fd = scalarOf(c, f);
+        if (op == nir_op_fmul) {
+            r = {mul(c, fd, yb.a), mul(c, fd, yb.b)};
+        } else {
+            const Built z = build(c, at(2));
+            r = {fma(c, fd, yb.a, z.a), fma(c, fd, yb.b, z.b)};
+        }
+        break;
+    }
+    case nir_op_bcsel: {
+        nir_def* cond = scalarOf(c, at(0));
+        const Built x = build(c, at(1)), y = build(c, at(2));
+        const unsigned bits = s.def->bit_size;
+        auto sel = [&](nir_def* p, nir_def* q) -> nir_def* {
+            if (p == nullptr && q == nullptr) return nullptr;
+            return nir_bcsel(c.b, cond, p ? p : zero(c, bits), q ? q : zero(c, bits));
+        };
+        r = {sel(x.a, y.a), sel(x.b, y.b)};
+        break;
+    }
+    default: {   // a conversion (analyze let nothing else through)
+        const Built x = build(c, at(0));
+        r = {conv(c, op, x.a), conv(c, op, x.b)};
+        break;
+    }
+    }
+    c.built[k] = r;
+    return r;
+}
+
+bool isColor0(nir_variable* v) { return v != nullptr && v->data.mode == nir_var_shader_out && v->data.location == FRAG_RESULT_DATA0 && v->data.index == 0; }
+
+// B's channel is 1 - A.a, as the shader wrote it: fadd(1, -x), fsub(1, x) or ffma(x, -1, 1), x being A.a
+bool isOneMinus(nir_scalar bs, nir_scalar alpha) {
+    bs = nir_scalar_chase_movs(bs);
+    alpha = nir_scalar_chase_movs(alpha);
+    auto same = [&](nir_scalar x) { x = nir_scalar_chase_movs(x); return x.def == alpha.def && x.comp == alpha.comp; };
+    auto isConst = [](nir_scalar x, double v) { x = nir_scalar_chase_movs(x); return nir_scalar_is_const(x) && nir_scalar_as_float(x) == v; };
+    auto negOf = [&](nir_scalar x) {
+        x = nir_scalar_chase_movs(x);
+        return nir_scalar_is_alu(x) && nir_scalar_alu_op(x) == nir_op_fneg && same(nir_scalar_chase_alu_src(x, 0));
+    };
+    if (!nir_scalar_is_alu(bs)) return false;
+    auto at = [&](unsigned i) { return nir_scalar_chase_alu_src(bs, i); };
+    switch (nir_scalar_alu_op(bs)) {
+    case nir_op_fadd:
+        return (isConst(at(0), 1.0) && negOf(at(1))) || (isConst(at(1), 1.0) && negOf(at(0)));
+    case nir_op_fsub:
+        return isConst(at(0), 1.0) && same(at(1));
+    case nir_op_ffma:
+        return isConst(at(2), 1.0) && ((same(at(0)) && isConst(at(1), -1.0)) || (same(at(1)) && isConst(at(0), -1.0)));
+    default:
+        return false;
+    }
+}
+
+}  // namespace fetchblend
+
+// The rewrite itself, between ir3_finalize_nir (the constants folded, the outputs one store each) and lowerFbRead:
+// kFetchBlendNone when the stage is left alone, else the blend the draw must use (render.hpp: Program::fetchBlend).
+// HM_FETCHBLEND_DUMP=1 (host) prints the decision and the NIR before and after.
+uint8_t fetchToBlend(nir_shader* nir) {
+    using namespace fetchblend;
+    if (nir->info.stage != MESA_SHADER_FRAGMENT || !nir->info.fs.uses_fbfetch_output) return kFetchBlendNone;
+    const bool dump = getenv("HM_FETCHBLEND_DUMP") != nullptr;
+    auto no = [&](const char* why) {
+        if (dump) fprintf(stderr, "fetchblend: %s: left as it is: %s\n", nir->info.name ? nir->info.name : "?", why);
+        return kFetchBlendNone;
+    };
+    nir_function_impl* impl = nir_shader_get_entrypoint(nir);
+    if (impl == nullptr) return no("no entry point");
+    Ctx c;
+    std::vector<nir_intrinsic_instr*> otherOutputs;
+    nir_foreach_block(block, impl) {
+        nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic) continue;
+            nir_intrinsic_instr* in = nir_instr_as_intrinsic(instr);
+            if (in->intrinsic == nir_intrinsic_load_output) {
+                const nir_io_semantics io = nir_intrinsic_io_semantics(in);
+                if (!io.fb_fetch_output) continue;
+                if (io.location != FRAG_RESULT_DATA0 || io.dual_source_blend_index != 0) return no("it reads a target other than colour 0");
+                c.fetches.insert(&in->def);
+            }
+        }
+    }
+    if (c.fetches.empty()) return no("no read of colour 0");
+    // every def a fetch reaches, and where the values end: colour 0's one store, nothing else
+    nir_intrinsic_instr* store = nullptr;
+    std::vector<nir_def*> work(c.fetches.begin(), c.fetches.end());
+    c.tainted.insert(c.fetches.begin(), c.fetches.end());
+    while (!work.empty()) {
+        nir_def* d = work.back();
+        work.pop_back();
+        nir_foreach_use_including_if(use, d) {
+            if (nir_src_is_if(use)) return no("a branch reads the destination");
+            nir_instr* user = nir_src_parent_instr(use);
+            if (user->type == nir_instr_type_intrinsic) {
+                nir_intrinsic_instr* in = nir_instr_as_intrinsic(user);
+                if (in->intrinsic == nir_intrinsic_store_deref && use == &in->src[1] && isColor0(nir_intrinsic_get_var(in, 0))) {
+                    if (store != nullptr && store != in) return no("colour 0 is stored more than once");
+                    store = in;
+                    continue;
+                }
+                if (!nir_intrinsic_infos[in->intrinsic].has_dest) return no("the destination reaches a store or a discard");
+            }
+            nir_def* out = nir_instr_def(user);
+            if (out == nullptr) return no("the destination reaches an instruction with no value");
+            if (c.tainted.insert(out).second) work.push_back(out);
+        }
+    }
+    if (store == nullptr) return no("colour 0 is not stored from the destination");
+    nir_variable* color0 = nir_intrinsic_get_var(store, 0);
+    nir_def* value = store->src[1].ssa;
+    const unsigned wrmask = nir_intrinsic_write_mask(store);
+    const unsigned comps = value->num_components;
+    for (unsigned ch = 0; ch < comps; ch++) {
+        if ((wrmask & (1u << ch)) == 0) continue;
+        const Lin l = analyze(c, nir_get_scalar(value, ch));
+        if (l.kind == 2) {
+            if (dump) nir_print_shader(nir, stderr);
+            return no("colour 0 is not A + B * destination");
+        }
+        if (l.kind == 1 && l.ch != ch) return no("a channel of colour 0 reads another channel of the destination");
+    }
+    // the other colour outputs, which the dual-source form cannot keep
+    bool others = false;
+    nir_foreach_shader_out_variable(v, nir) {
+        if (v->data.location >= FRAG_RESULT_DATA0 && !isColor0(v)) others = true;
+    }
+    if (dump) {
+        fprintf(stderr, "fetchblend: %s: the NIR before:\n", nir->info.name ? nir->info.name : "?");
+        nir_print_shader(nir, stderr);
+    }
+    nir_builder b = nir_builder_at(nir_before_instr(&store->instr));
+    c.b = &b;
+    Built ch[4];
+    for (unsigned i = 0; i < comps && i < 4; i++) ch[i] = build(c, nir_get_scalar(value, i));
+    // source-over: every channel's B the one value 1 - A.a
+    bool over = comps == 4 && ch[3].a != nullptr;
+    auto sameScalar = [](nir_def* x, nir_def* y) {
+        const nir_scalar p = nir_scalar_chase_movs(nir_get_scalar(x, 0)), q = nir_scalar_chase_movs(nir_get_scalar(y, 0));
+        return p.def == q.def && p.comp == q.comp;
+    };
+    for (unsigned i = 0; over && i < 4; i++) {
+        over = ch[i].b != nullptr && sameScalar(ch[i].b, ch[0].b);
+    }
+    if (over) {
+        // (B was built from the shader's own 1 - a, a free def: scalarOf gives the same channel def for each, so the
+        // comparison is on what it was built from)
+        over = isOneMinus(nir_get_scalar(ch[0].b, 0), nir_get_scalar(ch[3].a, 0));
+    }
+    if (!over && others) {
+        return no("the blend needs a second source and the stage writes other colour outputs");
+    }
+    const unsigned bits = value->bit_size;
+    nir_def* av[4];
+    nir_def* bv[4];
+    for (unsigned i = 0; i < comps; i++) {
+        av[i] = ch[i].a != nullptr ? ch[i].a : zero(c, bits);

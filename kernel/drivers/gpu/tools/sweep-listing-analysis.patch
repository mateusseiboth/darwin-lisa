+// analysis: HM_NOBIAS=1 drops a txb's bias (txb -> tex), to see what ir3 makes of the sample without it
+bool dropBias(nir_builder*, nir_instr* instr, void*) {
+    if (instr->type != nir_instr_type_tex) return false;
+    nir_tex_instr* tex = nir_instr_as_tex(instr);
+    if (tex->op != nir_texop_txb) return false;
+    int i = nir_tex_instr_src_index(tex, nir_tex_src_bias);
+    if (i >= 0) nir_tex_instr_remove_src(tex, i);
+    tex->op = nir_texop_tex;
+    return true;
+}

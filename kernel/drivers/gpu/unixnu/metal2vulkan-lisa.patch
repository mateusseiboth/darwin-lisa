+/// darwin-lisa: whether `M2V_RENDER_AREA=1` asks for trimmed render areas, read once.
+fn render_area_trimming() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("M2V_RENDER_AREA").is_ok_and(|v| v == "1"))
+}
+
+/// darwin-lisa: the render area bounding a pass's draws (`EndPass`'s `drawn`), where trimming is asked for and the pass
+/// reaches nothing outside its draws (`plain`: no execution, pending pipeline, tile dispatch or resolve step; checked here:
+/// no `Clear` load, no resolve, one layer). `None`: the whole attachment.
+fn trimmed_render_area(layout: &PassLayout, drawn: &clear_reach::DrawnArea, plain: bool) -> Option<vk::Rect2D> {
+    if !render_area_trimming() {
+        return None;
+    }
+    RENDER_AREA_STATS[0].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let area = trimmed_area(layout, drawn, plain)?;
+    let [width, height] = layout.extent;
+    RENDER_AREA_STATS[1].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    RENDER_AREA_STATS[2].fetch_add(
+        u64::from(width) * u64::from(height) - u64::from(area.extent.width) * u64::from(area.extent.height),
+        std::sync::atomic::Ordering::Relaxed,
+    );
+    Some(area)
+}
+
+/// darwin-lisa: passes looked at, passes trimmed, and the pixels trimming left out ([`trimmed_render_area`]).
+static RENDER_AREA_STATS: [std::sync::atomic::AtomicU64; 3] = [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+
+/// darwin-lisa: [`RENDER_AREA_STATS`], for the AdrenoMetal plug-in's report.
+pub fn darwin_lisa_render_area_stats() -> [u64; 3] {
+    RENDER_AREA_STATS.each_ref().map(|c| c.load(std::sync::atomic::Ordering::Relaxed))
+}
+
+fn trimmed_area(layout: &PassLayout, drawn: &clear_reach::DrawnArea, plain: bool) -> Option<vk::Rect2D> {
+    if !plain || layout.layers > 1 {
+        return None;
+    }
+    let colors_keep = layout
+        .colors
+        .iter()
+        .flatten()
+        .all(|c| c.load != LoadAction::Clear && c.resolve.is_none() && c.copied_resolve.is_none());
+    let depth_keeps = layout.depth_stencil.as_ref().is_none_or(|ds| {
+        ds.resolve.is_none()
+            && ds.depth.is_none_or(|a| a.load != LoadAction::Clear)
+            && ds.stencil.is_none_or(|a| a.load != LoadAction::Clear)
+    });
+    if !colors_keep || !depth_keeps {
+        return None;
+    }
+    let [width, height] = layout.extent;
+    let [x0, y0, x1, y1] = drawn.bounds()?;
+    let (x1, y1) = (x1.min(width), y1.min(height));
+    if x0 >= x1 || y0 >= y1 || (x0 == 0 && y0 == 0 && x1 == width && y1 == height) {
+        return None;
+    }
+    if std::env::var_os("M2V_RENDER_AREA_LOG").is_some() {
+        eprintln!("metal2vulkan: render area {x0},{y0} {}x{} of {width}x{height}", x1 - x0, y1 - y0);
+    }
+    Some(vk::Rect2D {
+        offset: vk::Offset2D { x: x0 as i32, y: y0 as i32 },
+        extent: vk::Extent2D { width: x1 - x0, height: y1 - y0 },
+    })
+}

+impl<M> ShadowCopy<M> {
+    /// darwin-lisa: the texels a copy in of a 2D texture's image over a buffer's bytes moves (its
+    /// every region's), and whether it is a copy in that converts a surface's two planes.
+    pub(super) fn texels_in(&self) -> (u64, bool) {
+        if !matches!(self.step, Step::Into) {
+            return (0, false);
+        }
+        if matches!(self.copies.source, ShadowSource::Converted { .. }) {
+            return (0, true);
+        }
+        let Some(ShadowTarget::Image { regions, .. }) = self.copies.target() else {
+            return (0, false);
+        };
+        let texels = regions
+            .iter()
+            .map(|r| {
+                let e = r.image_extent;
+                u64::from(e.width) * u64::from(e.height) * u64::from(e.depth)
+            })
+            .sum();
+        (texels, false)
+    }
+}

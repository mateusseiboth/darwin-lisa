+/* (darwin-lisa) A specialised function on iOS 26 (see the header): the library's own, with the values beside it. A
+ * descriptor without values, or a name the library does not have, goes Metal's own way. */
+static id
+hm_fn_descriptor(id self, SEL sel, MTLFunctionDescriptor *descriptor, NSError **error)
+{
+	NSString *name = [descriptor name];
+	MTLFunctionConstantValues *values = [descriptor constantValues];
+	id f = nil;
+
+	if (name == nil || values == nil) {
+		return hm_orig_fn_descriptor(self, sel, descriptor, error);
+	}
+	if (hm_boot_arg_set("metal_fc_native=1")) {
+		f = hm_orig_fn_descriptor(self, sel, descriptor, error);
+		if (f != nil) {
+			HM_ONCE("function constants: Metal specialised %s itself (metal_fc_native=1)\n", [name UTF8String]);
+			return f;
+		}
+		HM_ONCE("function constants: Metal could not specialise %s (%s); the values are kept beside it instead\n",
+			[name UTF8String], error != NULL && *error != nil ? [[*error description] UTF8String] : "no reason");
+	}
+	f = [self newFunctionWithName:name];
+	if (f == nil) {
+		return hm_orig_fn_descriptor(self, sel, descriptor, error);
+	}
+	objc_setAssociatedObject(f, &hm_fc_key, [[values copy] autorelease], OBJC_ASSOCIATION_RETAIN);
+	if (error != NULL) {
+		*error = nil;
+	}
+	HM_ONCE("function constants: %s and the next ones keep their descriptor's values beside them (iOS 26)\n", [name UTF8String]);
+	return f;
+}
 

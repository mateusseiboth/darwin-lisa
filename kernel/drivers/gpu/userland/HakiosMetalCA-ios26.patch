+static BOOL
+hm_ios26(void)
+{
+	static dispatch_once_t once;
+	static BOOL yes;
+
+	dispatch_once(&once, ^{
+		Class function = NSClassFromString(@"_MTLFunctionInternal"), library = NSClassFromString(@"_MTLLibrary");

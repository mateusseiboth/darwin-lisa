+/* darwin-lisa: whether this process is shown the device under metal_all=MODE: 0 the window server alone, 1 the
+ * processes that draw (apps, SpringBoard, app extensions, metal_test), 2 every process */
+static bool
+hm_shown_the_device(int mode, const char *name)
+{
+	char path[1024];
+	uint32_t length = sizeof(path);
+
+	if (name != NULL && strcmp(name, "backboardd") == 0) return true;
+	if (mode >= 2) return true;
+	if (mode < 1) return false;
+	if (name != NULL && strcmp(name, "metal_test") == 0) return true;
+	if (_NSGetExecutablePath(path, &length) != 0) return false;
+	if (strncmp(path, "/Applications/", 14) == 0) return true;
+	if (strncmp(path, "/private/var/containers/Bundle/", 31) == 0 || strncmp(path, "/var/containers/Bundle/", 23) == 0) return true;
+	if (strncmp(path, "/System/Library/CoreServices/", 29) == 0 && strstr(path, ".app/") != NULL) return true;
+	return strstr(path, ".appex/") != NULL;
+}

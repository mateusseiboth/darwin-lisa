+/* the program for one content KEY of the deciding buffer, compiled (one at a time), kept, and returned; NULL when
+ * hakios-metal refuses it (kept as refused) */
+- (hakios_metal_program *)hakiosSpecialise:(NSData *)key
+{
+	static pthread_mutex_t one = PTHREAD_MUTEX_INITIALIZER;
+	struct timespec t0, t1;
+
+	pthread_mutex_lock(&one);
+	clock_gettime(CLOCK_MONOTONIC, &t0);
+	hakios_metal_program *p = hakios_metal_program_specialize(_program, [_fsAir bytes], [_fsAir length], _fsConstants, _fsConstantCount,
+								 (unsigned)_specBinding, [key bytes], [key length]);
+	clock_gettime(CLOCK_MONOTONIC, &t1);
+	pthread_mutex_unlock(&one);
+	if (p == NULL) {
+		hm_print("specialise: %s for its buffer %d: %s; its draws are left out\n", hakios_metal_program_name(_program), _specBinding,
+			 hakios_metal_error());
+	} else if (hm_fps_on()) {
+		hm_print("specialise: %s for %u bytes of its buffer %d: %u instruction words, not %u, in %.0f ms\n", hakios_metal_program_name(_program),
+			 _specLength, _specBinding, hakios_metal_program_stage_words(p, 1), hakios_metal_program_stage_words(_program, 1),
+			 (t1.tv_sec - t0.tv_sec) * 1e3 + (t1.tv_nsec - t0.tv_nsec) / 1e6);
+	}
+	@synchronized(self) {
+		[_specialised setObject:p != NULL ? (id)[NSValue valueWithPointer:p] : (id)[NSNumber numberWithBool:NO] forKey:key];
+	}
+	return p;
+}

+ * compressed target against 1.45 into an uncompressed one, and the window server here draws every layer of a frame
+ * into the linear surface the display scans out (0.9 ms a full-screen layer measured, session 9). The surface stays
+ * what the display and every other reader sees: the passes draw into a compressed copy of it and the 2D engine lays
+ * the copy into the surface at the command buffer's commit, as for a framebuffer with a rotation (-hakiosTurnInto:);
+ * a pass that loads finds the last frame in the copy, which is filled from the surface first when the processor wrote
+ * the surface since (its seed moved) or the copy is new. Only surfaces of a million pixels or more (the display's), one
+ * plane, BGRA8 or RGBA8, drawn into and not written by a kernel. Off unless asked.
+ */
+static BOOL
+hm_compress_fb_on(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		char args[1024] = {0};
+		size_t size = sizeof(args) - 1;
+
+		on = sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0 && strstr(args, "metal_ubwc_fb=1") != NULL && strstr(args, "metal_noubwc") == NULL;
+		if (on) {
+			HM_ONCE("metal_ubwc_fb=1: framebuffer surfaces of a million pixels or more are drawn compressed (UBWC) and laid into "
+				"their surfaces at commit\n");
+		}
+	}
+	return on > 0;
+}

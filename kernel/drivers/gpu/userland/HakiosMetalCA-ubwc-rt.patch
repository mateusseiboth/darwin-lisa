+ * darwin-lisa, boot-arg metal_ubwc_rt=1: CoreAnimation's offscreen render targets -- the backdrops the glass samples,
+ * its blur levels, the layers it flattens -- drawn, cleared and sampled compressed (UBWC), as turnip lays out every
+ * optimal image. Linear, each full-screen read of one costs the texture unit about 0.85 ms and each Clear of a
+ * 1088x2432 RGBA16Float one about 1.8 ms (21 MB); compressed, a Clear writes a few bytes a block and the reads and
+ * writes of flat UI content move a fraction of the bytes. Only what the CPU can never touch: private or memoryless
+ * storage, a render target not written by a kernel and not to be viewed in another format, one 2D level of RGBA8,
+ * BGRA8 or RGBA16Float, 256x256 pixels or more. A copy out of it (blit, texture to buffer) is the 2D engine reading it
+ * compressed. Off unless asked: the layout is drawn into on the phone for the first time with it (hakios-metal
+ * render_test a_compressed_render_target_is_cleared_drawn_sampled_and_copied_out_compressed runs it on the fake GPU).
+ */
+static BOOL
+hm_compress_rt_on(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		char args[1024] = {0};
+		size_t size = sizeof(args) - 1;
+
+		on = sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0 && strstr(args, "metal_ubwc_rt=1") != NULL && strstr(args, "metal_noubwc") == NULL;
+		if (on) {
+			HM_ONCE("metal_ubwc_rt=1: private and memoryless render targets of RGBA8, BGRA8 and RGBA16Float are compressed (UBWC)\n");
+		}
+	}
+	return on > 0;
+}
+
+static BOOL
+hm_compress_rt(MTLTextureDescriptor *descriptor, MTLTextureUsage usage)
+{
+	const MTLPixelFormat f = [descriptor pixelFormat];
+
+	return hm_compress_rt_on() && [descriptor textureType] == MTLTextureType2D && [descriptor mipmapLevelCount] == 1 && [descriptor sampleCount] == 1 &&
+	       [descriptor arrayLength] == 1 && (f == MTLPixelFormatRGBA8Unorm || f == MTLPixelFormatBGRA8Unorm || f == MTLPixelFormatRGBA16Float) &&
+	       (usage & MTLTextureUsageRenderTarget) != 0 && (usage & MTLTextureUsageShaderWrite) == 0 &&
+	       ([descriptor usage] & MTLTextureUsagePixelFormatView) == 0 &&
+	       ([descriptor storageMode] == MTLStorageModePrivate || [descriptor storageMode] == MTLStorageModeMemoryless) &&
+	       [descriptor width] * [descriptor height] >= 65536;
+}

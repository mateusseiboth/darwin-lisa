+/*
+ * darwin-lisa: a selector that no protocol in this process declares (the AGX bundle's SPIs, which QuartzCore 26 sends
+ * to the window server's command buffers: -setResponsibleTaskIDs:count: first) used to go to -doesNotRecognizeSelector:
+ * and raise, and backboardd aborted at every launch. It is answered instead, with a signature guessed from its name:
+ * every argument an integer register, and the return void for a setter or an action (set..., add..., remove...,
+ * use..., encode..., wait..., signal..., present..., commit..., enqueue...), else an integer, so the caller reads
+ * nil, NO or 0. Only a float or struct return would be wrong, and such a selector still says so in the refusal line.
+ */
+static NSMethodSignature *
+hm_guessed_signature(SEL sel)
+{
+	static const char *const kVoid[] = { "set", "add", "remove", "use", "encode", "wait", "signal", "present",
+					     "commit", "enqueue", "insert", "push", "pop", "update", "reset", "release" };
+	const char *name = sel_getName(sel);
+	char types[64];
+	size_t n = 0;
+	BOOL isVoid = NO;
+
+	for (size_t i = 0; i < sizeof(kVoid) / sizeof(kVoid[0]); i++) {
+		size_t len = strlen(kVoid[i]);
+
+		if (strncmp(name, kVoid[i], len) == 0 && (name[len] == '\0' || name[len] == ':' ||
+		    (name[len] >= 'A' && name[len] <= 'Z'))) {
+			isVoid = YES;
+			break;
+		}
+	}
+	types[n++] = isVoid ? 'v' : 'Q';
+	types[n++] = '@';
+	types[n++] = ':';
+	for (const char *c = name; *c != '\0' && n + 2 < sizeof(types); c++) {
+		if (*c == ':') {
+			types[n++] = 'Q';
+		}
+	}
+	types[n] = '\0';
+	return [NSMethodSignature signatureWithObjCTypes:types];
+}
+
+/* what -methodSignatureForSelector: answers for a selector no class in the chain implements: the declared signature
+ * when a protocol has one, the guessed one otherwise (so nothing raises) */
+static NSMethodSignature *
+hm_method_signature(Class cls, SEL sel)
+{
+	NSMethodSignature *s = hm_protocol_signature(cls, sel);
+
+	return s != nil ? s : hm_guessed_signature(sel);
+}

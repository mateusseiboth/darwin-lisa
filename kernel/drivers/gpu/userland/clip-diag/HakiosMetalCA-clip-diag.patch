+/* darwin-lisa, boot-arg metal_ml_clear=1 (an experiment, off by default): a memoryless colour attachment past 0 that
+ * the pass would begin with DontCare begins Cleared to zero instead. Memoryless contents are undefined at a pass's
+ * start on an Apple GPU; here such a texture is ordinary memory and keeps what the last pass that used it left. */
+static BOOL
+hm_ml_clear(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		char args[1024] = "";
+		size_t size = sizeof(args) - 1;
+
+		on = sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0 && strstr(args, "metal_ml_clear=1") != NULL;
+	}
+	return on != 0;
+}
+
+static BOOL hm_tracing(void);
+
+/* darwin-lisa (clip diagnostics, metal_trace=1): each kind of pass once -- colour attachments 0 to 2 with their size,
+ * format, storage (S shared, P private, M memoryless), load and store actions -- and the core's counts of fetches given
+ * attachment 0 for a missing target and of constants pushed as zeros, whenever they change */
+static void
+hm_trace_pass(MTLRenderPassDescriptor *d)
+{
+	static NSMutableSet *seen;
+	static unsigned printed, lastFb = ~0u, lastZero = ~0u;
+	NSMutableString *line;
+
+	if (!hm_tracing() || d == nil) return;
+	line = [NSMutableString string];
+	for (NSUInteger i = 0; i < 3; i++) {
+		MTLRenderPassColorAttachmentDescriptor *c = [[d colorAttachments] objectAtIndexedSubscript:i];
+		id t = c != nil ? [c texture] : nil;
+		static const char kStorage[] = "SMPM";
+
+		if (t == nil) {
+			[line appendFormat:@" a%lu none", (unsigned long)i];
+			continue;
+		}
+		[line appendFormat:@" a%lu %lux%lu fmt %lu %c load %lu store %lu%s", (unsigned long)i, (unsigned long)[t width], (unsigned long)[t height],
+			(unsigned long)[t pixelFormat], (unsigned long)[t storageMode] < 4 ? kStorage[[t storageMode]] : '?',
+			(unsigned long)[c loadAction], (unsigned long)[c storeAction],
+			[t isKindOfClass:[HakiosMetalTexture class]] && hakios_metal_texture_iosurface([(HakiosMetalTexture *)t hakiosTexture]) != 0 ? " (surface)" : ""];
+	}
+	@synchronized ([NSMutableSet class]) {
+		if (seen == nil) seen = [[NSMutableSet alloc] init];
+		if (printed < 400 && ![seen containsObject:line]) {
+			[seen addObject:line];
+			printed++;
+			hm_print("trace: pass%s\n", [line UTF8String]);
+		}
+	}
+	{
+		unsigned fb = 0, zero = 0;
+		char fbStage[96] = "", zeroStage[96] = "";
+
+		hakios_metal_diag_counts(&fb, &zero, fbStage, sizeof(fbStage), zeroStage, sizeof(zeroStage));
+		if (fb != lastFb || zero != lastZero) {
+			hm_print("trace: so far %u draws fetched attachment 0 for a target their pass has not (last: %s), %u constant ranges pushed as "
+				 "zeros for an unbound buffer (last: %s)\n", fb, fbStage, zero, zeroStage);
+			lastFb = fb;
+			lastZero = zero;
+		}
+	}
+}

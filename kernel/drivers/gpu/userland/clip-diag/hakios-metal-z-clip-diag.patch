+// darwin-lisa (clip diagnostics): hakios_metal.h's reader of the counts above
+extern "C" void hakios_metal_diag_counts(unsigned* fb_fallbacks, unsigned* zero_pushes, char* fb_stage, size_t fb_size, char* zero_stage, size_t zero_size) {
+    using namespace hakios::metal;
+    if (fb_fallbacks != nullptr) *fb_fallbacks = gDiagFbFallbacks.load(std::memory_order_relaxed);
+    if (zero_pushes != nullptr) *zero_pushes = gDiagZeroPushes.load(std::memory_order_relaxed);
+    if (fb_stage != nullptr && fb_size != 0) snprintf(fb_stage, fb_size, "%s", gDiagFbFallbackStage);
+    if (zero_stage != nullptr && zero_size != 0) snprintf(zero_stage, zero_size, "%s", gDiagZeroPushStage);

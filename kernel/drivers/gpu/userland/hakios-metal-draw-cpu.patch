diff --git a/tools/drawbench.cpp b/tools/drawbench.cpp
new file mode 100644
index 0000000..fd04f1f
--- /dev/null
+++ b/tools/drawbench.cpp
@@ -0,0 +1,113 @@
+// drawbench: what CommandBuffer::draw costs the processor, draw by draw, in the shape of a CoreAnimation frame (one
+// window-sized target, some 85 draws in one pass, three programs taking turns, a constant buffer, a texture and its
+// sampler per textured draw, the buffers and textures kept as the C interface keeps them). Against the fake GPU, so
+// it runs on the host under perf:
+//
+//   make drawbench && out/host/drawbench [FRAMES] [DRAWS]
+//   perf record -g out/host/drawbench 400 && perf report
+//
+// SPDX-License-Identifier: MIT
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "hakios-metal/command.hpp"
+#include "hakios-metal/fake_gpu.hpp"
+#include "hakios-metal/render.hpp"
+#include "hakios-metal/texture.hpp"
+#include "../tests/fixtures/tri_cflat_fs_air.hpp"
+#include "../tests/fixtures/tri_color_fs_air.hpp"
+#include "../tests/fixtures/tri_color_vs_air.hpp"
+#include "../tests/fixtures/tri_flat_vs_air.hpp"
+#include "../tests/fixtures/tri_tex_fs_air.hpp"
+
+using namespace hakios::metal;
+namespace kernels = hakios::metal::kernels;
+
+namespace {
+std::shared_ptr<Texture> makeTexture(Gpu& gpu, uint32_t w, uint32_t h, uint32_t usage) {
+    TextureDesc d;
+    d.format = PixelFormat::kBGRA8Unorm;
+    d.width = w;
+    d.height = h;
+    d.usage = usage;
+    std::string why;
+    auto t = Texture::make(gpu, d, &why);
+    if (t == nullptr) std::fprintf(stderr, "drawbench: no texture: %s\n", why.c_str());
+    return t;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    const int frames = argc > 1 ? std::atoi(argv[1]) : 200;
+    const int draws = argc > 2 ? std::atoi(argv[2]) : 85;
+    const char* pattern = argc > 3 ? argv[3] : nullptr;   // which program each draw takes in turn (0 tex, 1 cflat, 2 color)
+    auto f = std::make_unique<FakeGpu>();
+    FakeGpu* fake = f.get();
+    Gpu gpu(std::move(f));
+    std::string why;
+    auto queue = CommandQueue::make(gpu, &why);
+    if (queue == nullptr) {
+        std::fprintf(stderr, "drawbench: no queue: %s\n", why.c_str());
+        return 1;
+    }
+    auto target = makeTexture(gpu, 1080, 2400, kTextureUsageRenderTarget | kTextureUsageRead);
+    std::vector<std::shared_ptr<Texture>> images;
+    for (int i = 0; i < 8; i++) images.push_back(makeTexture(gpu, 128, 128, kTextureUsageRead));
+    Sampler smp;
+    if (target == nullptr || !makeSampler(SamplerDesc{}, &smp, &why)) return 1;
+    std::vector<std::shared_ptr<Buffer>> constants;
+    for (int i = 0; i < 4; i++) constants.push_back(newBuffer(gpu, 4096, &why));
+    const Program programs[3] = {Program{kernels::tri_color_vs_air, kernels::tri_tex_fs_air, Linkage{}, "tri_tex"},
+                                 Program{kernels::tri_flat_vs_air, kernels::tri_cflat_fs_air, Linkage{}, "tri_cflat"},
+                                 Program{kernels::tri_color_vs_air, kernels::tri_color_fs_air, Linkage{}, "tri_color"}};
+    RenderPass pass;
+    pass.color0 = target.get();
+    double drawNs = 0;
+    uint64_t drawn = 0;
+    for (int frame = 0; frame < frames; frame++) {
+        auto cb = queue->commandBuffer();
+        for (int i = 0; i < draws; i++) {
+            const int which = pattern != nullptr ? pattern[i % std::strlen(pattern)] - '0' : (i / 3) % 3;   // runs of three draws of one program, as CA's layers come
+            const Program& p = programs[which];
+            Draw d;
+            d.vertexCount = 6;
+            d.viewport = Viewport{0, 0, 1080, 2400, 0, 1};
+            d.scissor = Scissor{uint32_t(i % 10) * 40, uint32_t(i % 7) * 60, 400, 300};
+            Bindings vsb, fsb;
+            vsb.buffers = {Binding{constants[i % 4].get(), uint64_t(i % 16) * 256}};
+            if (which == 0) {
+                fsb.textures = {images[i % 8].get()};
+                fsb.samplers = {&smp};
+            } else if (which == 1) {
+                fsb.buffers = {Binding{constants[(i + 1) % 4].get(), uint64_t(i % 16) * 256}};
+            }
+            const auto t0 = std::chrono::steady_clock::now();
+            if (!cb->draw(p, pass, d, vsb, fsb)) {
+                std::fprintf(stderr, "drawbench: draw %d of frame %d refused: %s\n", i, frame, cb->error().c_str());
+                return 1;
+            }
+            // what the C interface keeps for the GPU's time (c_api.cpp drawCommon)
+            cb->keep(constants[i % 4]);
+            if (which == 1) cb->keep(constants[(i + 1) % 4]);
+            cb->keep(target->buffer());
+            cb->keepAlive(target);
+            if (which == 0) cb->keepAlive(images[i % 8]);
+            drawNs += std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - t0).count();
+            drawn++;
+        }
+        if (std::getenv("DRAWBENCH_NOCOMMIT") != nullptr) continue;   // (perf: the draws alone, not the fake running them)
+        cb->commit();
+        cb->waitUntilCompleted();
+        if (cb->status() != CommandBuffer::kCompleted) {
+            std::fprintf(stderr, "drawbench: frame %d did not complete: %s | %s\n", frame, cb->error().c_str(), fake->stats().lastFault.c_str());
+            return 1;
+        }
+    }
+    std::printf("drawbench: %llu draws in %d frames of %d: %.2f us a draw\n", (unsigned long long)drawn, frames, draws, drawNs / 1e3 / double(drawn));
+    return 0;
+}

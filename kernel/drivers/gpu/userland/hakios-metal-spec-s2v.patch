+// darwin-lisa: every load_scratch/store_scratch at a constant offset (nir_lower_scratch_to_var can then make values of it)
+bool scratchOffsetsConstant(nir_shader* nir) {
+    nir_foreach_function_impl(impl, nir) {
+        nir_foreach_block(block, impl) {
+            nir_foreach_instr(instr, block) {
+                if (instr->type != nir_instr_type_intrinsic) continue;
+                nir_intrinsic_instr* in = nir_instr_as_intrinsic(instr);
+                if (in->intrinsic == nir_intrinsic_load_scratch && !nir_src_is_const(in->src[0])) return false;
+                if (in->intrinsic == nir_intrinsic_store_scratch && !nir_src_is_const(in->src[1])) return false;
+            }
+        }
+    }
+    return true;
+}

+// The table's texture and sampler parts are written as far as the command processor loads them (SP_FS_TEX_COUNT
+// descriptors, NSAMP samplers) and no further: on the phone the table is write-combined memory, and the sixteen slots of
+// each stage written in full, zeroed before that, were 3.8 KB a draw for a draw that loads one descriptor. What Encoded
+// filled the table with (0xee) is still there past what is loaded, and the draw still completes on the fake GPU.
+TEST(a_draw_writes_only_the_descriptors_the_command_processor_loads) {
+    Rig r;
+    auto t = target(r);
+    auto tex = target(r, 4, 4, kTextureUsageRead);
+    Sampler smp = nearestClamp();
+    RenderPass pass;
+    pass.color0 = t.get();
+    Bindings fsb;
+    fsb.textures = {tex.get()};
+    fsb.samplers = {&smp};
+    Encoded e(r, texProgram(), pass, wholeDraw(6), render::Options{}, Bindings{}, fsb);
+    CHECK(e.ok);
+    const uint8_t* table = static_cast<const uint8_t*>(e.table->contents());
+    auto untouched = [&](uint32_t from, uint32_t to) {
+        for (uint32_t i = from; i < to; i++) {
+            if (table[i] != 0xee) return false;
+        }
+        return true;
+    };
+    CHECK(untouched(render::kTableFsAt + 64, render::kTableFsAt + 16 * 64));                       // FS descriptors 1 to 15
+    CHECK(untouched(render::kTableFsAt + 16 * 64 + 16, render::kTableFsAt + 16 * 64 + 16 * 16));   // FS samplers 1 to 15
+    CHECK(untouched(render::kTableFsAt + 16 * 80, render::kTableFsAt + 16 * 160));                 // the VS's, none loaded
+    CHECK(!untouched(render::kTableFsAt, render::kTableFsAt + 64));                                // descriptor 0 written
+    Raw raw(r);
+    CHECK_EQ(raw.submit(e.stream.words()), 0);   // (the fake checks every descriptor and sampler the stream loads)
+    CHECK_EQ(r.fake->stats().faults, 0u);
+    if (r.fake->stats().faults) std::printf("       %s\n", r.fake->stats().lastFault.c_str());
+}

+uint64_t CommandBuffer::streamDigest() const {
+    uint64_t k = 0xcbf29ce484222325ull;
+    for (uint32_t w : stream_.words()) {
+        for (int i = 0; i < 4; i++) k = (k ^ ((w >> (8 * i)) & 0xff)) * 0x100000001b3ull;
+    }
+    return k;
+}

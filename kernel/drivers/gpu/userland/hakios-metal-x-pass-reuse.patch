+// Each pass deduplicates its registers from nothing (its batch start forgets what the GPU holds), however many passes the
+// buffer opened before it: a pass that comes back to a target after another pass writes as many words as the other did,
+// and its second draw as few as the first pass's second draw. CoreAnimation's app-close animation opens 49 passes a
+// buffer (gpu-c2, 2026-11-12), so the pass's bookkeeping is reused from one pass to the next; this is what must hold.
+TEST(each_pass_of_a_buffer_deduplicates_from_nothing) {
+    Rig r;
+    auto t = target(r);
+    auto other = target(r);
+    RenderPass a, b;
+    a.color0 = t.get();
+    b.color0 = other.get();
+    render::Options o;
+    o.gmem = false;
+    auto cb = r.queue->commandBuffer();
+    size_t at[6] = {cb->streamWords()};
+    CHECK(cb->draw(flatProgram(), a, wholeDraw(), Bindings{}, Bindings{}, o));   // pass 1: its head and a whole draw
+    at[1] = cb->streamWords();
+    CHECK(cb->draw(flatProgram(), a, wholeDraw(), Bindings{}, Bindings{}, o));   // the same draw again: deduplicated
+    at[2] = cb->streamWords();
+    CHECK(cb->draw(flatProgram(), b, wholeDraw(), Bindings{}, Bindings{}, o));   // pass 2: pass 1's tail, its head, a whole draw
+    at[3] = cb->streamWords();
+    CHECK(cb->draw(flatProgram(), a, wholeDraw(), Bindings{}, Bindings{}, o));   // pass 3, back to a: pass 2's tail, the same
+    at[4] = cb->streamWords();
+    CHECK(cb->draw(flatProgram(), a, wholeDraw(), Bindings{}, Bindings{}, o));
+    at[5] = cb->streamWords();
+    // the tail a pass closes with (appendStream's marker and encodeEnd's words), and pass 2's draw as a buffer's first
+    pm4::Stream tail;
+    render::encodeEnd(tail, a, 0, o);
+    const size_t tailWords = 1 + tail.words().size();
+    auto alone = r.queue->commandBuffer();
+    const size_t aloneAt = alone->streamWords();
+    CHECK(alone->draw(flatProgram(), b, wholeDraw(), Bindings{}, Bindings{}, o));
+    const size_t bAlone = alone->streamWords() - aloneAt;
+    // (a shadow kept from an earlier pass would leave the batch start's registers out of pass 2's and pass 3's heads)
+    CHECK_EQ(at[3] - at[2], tailWords + bAlone);
+    CHECK_EQ(at[4] - at[3], tailWords + (at[1] - at[0]));
+    CHECK_EQ(at[5] - at[4], at[2] - at[1]);
+    CHECK((at[2] - at[1]) * 3 < at[1] - at[0]);
+    alone->commit();
+    alone->waitUntilCompleted();
+    cb->commit();
+    cb->waitUntilCompleted();
+    CHECK(cb->status() == CommandBuffer::kCompleted);
+    CHECK_EQ(r.fake->stats().faults, 0u);
+}

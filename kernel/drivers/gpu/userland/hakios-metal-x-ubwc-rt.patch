+// darwin-lisa: a compressed render target (CoreAnimation's offscreen targets with metal_ubwc_rt=1): cleared by the 2D
+// engine into its UBWC layout, drawn into through RB_MRT with its flag buffer (TILE6_3, WZYX: the CCU writes a tiled
+// target in that order whatever the format's own), sampled and read back by a framebuffer fetch through its UBWC
+// descriptor, and copied out by the 2D engine reading it compressed. Its rows are the GPU's alone: replace and read
+// refuse, a view that changes nothing is the texture itself, and a swizzled view still reads it compressed. RGBA16Float
+// (the backdrops' format) is served for a render target too.
+TEST(a_compressed_render_target_is_cleared_drawn_sampled_and_copied_out_compressed) {
+    using namespace a6xx;
+    for (PixelFormat format : {PixelFormat::kBGRA8Unorm, PixelFormat::kRGBA16Float}) {
+        Rig r;
+        TextureDesc cd;
+        cd.format = format;
+        cd.width = 256;
+        cd.height = 256;
+        cd.usage = kTextureUsageRead | kTextureUsageRenderTarget;
+        cd.compressed = true;
+        std::string why;
+        auto ct = Texture::make(*r.gpu, cd, &why);
+        if (ct == nullptr && why.find("this build has none") != std::string::npos) {
+            std::printf("       (no Mesa in this build: %s; the compressed render target did not run)\n", why.c_str());
+            return;
+        }
+        CHECK(ct != nullptr);
+        if (ct == nullptr) { std::printf("       %s\n", why.c_str()); return; }
+        CHECK(ct->compressed() && ct->staging() == nullptr && ct->contents() == nullptr);
+        std::vector<uint8_t> rows(16 * 16 * 8);
+        CHECK(!ct->replace(0, 0, 16, 16, rows.data(), 16 * 8, &why));
+        CHECK(!ct->read(0, 0, 16, 16, rows.data(), 16 * 8, &why));
+        CHECK(Texture::view(ct, format, TextureType::k2D, 0, 1, 0, 1, &why) == ct);
+        CHECK(Texture::view(ct, PixelFormat::kRGBA8Unorm, TextureType::k2D, 0, 1, 0, 1, &why) == nullptr || format == PixelFormat::kRGBA8Unorm);
+        const uint8_t swz[4] = {5, 4, 3, 2};
+        auto sw = Texture::swizzled(ct, swz, &why);
+        CHECK(sw != nullptr && sw->compressed() && (sw->sampledDescriptor().dword[3] & A6XX_TEX_CONST_3_FLAG) != 0);
+        CHECK((ct->levelDescriptor(0).dword[3] & A6XX_TEX_CONST_3_FLAG) != 0);
+        CHECK_EQ((ct->levelDescriptor(0).dword[0] & A6XX_TEX_CONST_0_SWAP__MASK) >> A6XX_TEX_CONST_0_SWAP__SHIFT, uint32_t(WZYX));
+        // a Clear and a draw into it, one pass
+        const uint32_t fillsBefore = r.fake->stats().ubwcFills, drawsBefore = r.fake->stats().ubwcDraws;
+        {
+            auto cb = r.queue->commandBuffer();
+            RenderPass p = clearPass(ct.get(), 0.25, 0.5, 0.75, 1.0);
+            CHECK(cb->draw(flatProgram(), p, wholeDraw(3, 256, 256), Bindings{}, Bindings{}));
+            cb->commit();
+            cb->waitUntilCompleted();
+            CHECK(cb->status() == CommandBuffer::kCompleted);
+        }
+        CHECK_EQ(r.fake->stats().ubwcFills - fillsBefore, 1u);
+        CHECK_EQ(r.fake->stats().ubwcDraws - drawsBefore, 1u);
+        CHECK_EQ(r.fake->stats().lastDraw.mrtTileMode, uint32_t(TILE6_3));
+        CHECK_EQ(r.fake->stats().lastDraw.mrtSwap, uint32_t(WZYX));
+        // a pass that is only a Clear
+        {
+            auto cb = r.queue->commandBuffer();
+            CHECK(cb->clear(clearPass(ct.get(), 0, 0, 0, 0)));
+            cb->commit();
+            cb->waitUntilCompleted();
+            CHECK(cb->status() == CommandBuffer::kCompleted);
+        }
+        CHECK_EQ(r.fake->stats().ubwcFills - fillsBefore, 2u);
+        // sampled into a linear target, and read back by a framebuffer fetch as its own target
+        auto out = target(r, 256, 256, kTextureUsageRenderTarget | kTextureUsageRead, format);
+        {
+            Sampler smp = nearestClamp();
+            RenderPass p;
+            p.color0 = out.get();
+            Bindings fsb;
+            fsb.textures = {ct.get()};
+            fsb.samplers = {&smp};
+            auto cb = r.queue->commandBuffer();
+            CHECK(cb->draw(texProgram(), p, wholeDraw(6, 256, 256), Bindings{}, fsb));
+            RenderPass q;
+            q.color0 = ct.get();
+            const Program fb{kernels::tri_flat_vs_air, kernels::tri_fb_fs_air, Linkage{}, "tri_fb"};
+            CHECK(cb->draw(fb, q, wholeDraw(6, 256, 256), Bindings{}, Bindings{}));
+            cb->commit();
+            cb->waitUntilCompleted();
+            CHECK(cb->status() == CommandBuffer::kCompleted);
+        }
+        // copied out into a linear texture by the 2D engine, and into another compressed one
+        const uint32_t readsBefore = r.fake->stats().ubwcReads, copiesBefore = r.fake->stats().ubwcCopies;
+        auto ct2 = Texture::make(*r.gpu, cd, &why);
+        CHECK(ct2 != nullptr);
+        {
+            auto cb = r.queue->commandBuffer();
+            CHECK(cb->blit(*ct, 0, render::BlitRect{0, 0, 256, 256}, *out, 0, render::BlitRect{0, 0, 256, 256}, false));
+            CHECK(ct2 != nullptr && cb->blit(*ct, 0, render::BlitRect{0, 0, 256, 256}, *ct2, 0, render::BlitRect{0, 0, 256, 256}, false));
+            cb->commit();
+            cb->waitUntilCompleted();
+            CHECK(cb->status() == CommandBuffer::kCompleted);
+        }
+        CHECK_EQ(r.fake->stats().ubwcReads - readsBefore, 1u);
+        CHECK_EQ(r.fake->stats().ubwcCopies - copiesBefore, 1u);
+        CHECK_EQ(r.fake->stats().faults, 0u);
+        if (r.fake->stats().faults) std::printf("       %s\n", r.fake->stats().lastFault.c_str());
+    }
+}

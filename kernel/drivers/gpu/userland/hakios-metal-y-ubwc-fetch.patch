+// darwin-lisa session 13: a framebuffer fetch from a compressed target reads it from a pass of its own -- the pass so far
+// closed (its tail: the colour cache flushed and the caches with it) and a new one begun for the fetching draw -- never
+// mid-pass through the in-pass barrier, after which the Control Center's clip (S9-B, a compressed memoryless target
+// fetched) read as if never drawn. A linear target keeps the barrier and its one pass.
+TEST(a_fetch_from_a_compressed_target_reads_it_from_a_pass_of_its_own) {
+    for (bool compressed : {false, true}) {
+        Rig r;
+        TextureDesc cd;
+        cd.format = PixelFormat::kBGRA8Unorm;
+        cd.width = 256;
+        cd.height = 256;
+        cd.usage = kTextureUsageRead | kTextureUsageRenderTarget;
+        cd.compressed = compressed;
+        std::string why;
+        auto ct = Texture::make(*r.gpu, cd, &why);
+        if (ct == nullptr && why.find("this build has none") != std::string::npos) return;
+        CHECK(ct != nullptr);
+        if (ct == nullptr) return;
+        const Program fb{kernels::tri_flat_vs_air, kernels::tri_fb_fs_air, Linkage{}, "tri_fb"};
+        RenderPass q;
+        q.color0 = ct.get();
+        auto cb = r.queue->commandBuffer();
+        CHECK(cb->draw(flatProgram(), clearPass(ct.get(), 0.25, 0.5, 0.75, 1.0), wholeDraw(3, 256, 256), Bindings{}, Bindings{}));
+        CHECK(cb->draw(fb, q, wholeDraw(6, 256, 256), Bindings{}, Bindings{}));
+        CHECK_EQ(cb->counts().passes, compressed ? 2u : 1u);
+        cb->commit();
+        cb->waitUntilCompleted();
+        CHECK(cb->status() == CommandBuffer::kCompleted);
+        CHECK_EQ(r.fake->stats().faults, 0u);
+        if (r.fake->stats().faults) std::printf("       %s\n", r.fake->stats().lastFault.c_str());
+    }
+}
+

@@ -2878,6 +2878,14 @@ bool CommandBuffer::draw(const Program& program, const RenderPass& pass, const D
         const ColorAttachment &a = pass.more[i], &b = open_->pass.more[i];
         joins = a.texture == b.texture && a.level == b.level && a.store == b.store && (a.texture == nullptr || a.load != LoadAction::kClear);
     }
+    // (darwin-lisa session 13) A framebuffer fetch from a compressed attachment reads it from a pass of its own: the pass so
+    // far closed -- its tail flushes the colour cache and the caches after it, as before any draw that samples what an
+    // earlier pass drew, the one way a compressed target has been read right on the phone -- and this draw opening the
+    // next. Mid-pass, after the fetch barrier, the Control Center's compressed clip read as if never drawn (S9-B).
+    for (uint32_t i = 0; joins && program.fs.fbRead && i < kMaxColorOutputs; i++) {
+        const Texture* t = i == 0 ? pass.color0 : pass.more[i - 1].texture;
+        joins = t == nullptr || !t->compressed();
+    }
     // GMEM is decided as a pass opens, before its first draw is encoded (a draw in a tile is encoded for the tile:
     // encodeInPass). A draw a tile cannot replay ends a GMEM pass and opens a sysmem one of its own.
     std::string gmemWhy;

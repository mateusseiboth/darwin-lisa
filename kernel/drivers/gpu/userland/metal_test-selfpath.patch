 #import <sys/wait.h>
 #import <time.h>
 #import <unistd.h>
+#import <mach-o/dyld.h>
+
+/* (darwin-lisa) the path this program was started by: HakiOS had it at /redwood/bin, the iOS 26 root at /usr/local/bin */
+static const char *
+self_path(void)
+{
+	static char path[1024];
+	uint32_t size = sizeof(path);
+
+	if (path[0] == 0 && _NSGetExecutablePath(path, &size) != 0) {
+		strlcpy(path, "/usr/local/bin/metal_test", sizeof(path));
+	}
+	return path;
+}
 

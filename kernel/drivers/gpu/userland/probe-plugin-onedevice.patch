+/* (darwin-lisa) iOS 26: Metal asks the device which GPU architecture its precompiled binaries must be for
+ * (+[MTLLoader sliceIDForDevice:legacyDriverVersion:airntDriverVersion:] -> -targetDeviceArchitecture: cpuType,
+ * subType, driverVersion, versionCombined) and asserts "Target device architecture is nil" when the answer is nil.
+ * CoreAnimation 26 reached it through its binary archive (-[_MTLDevice newBinaryArchiveWithDescriptor:error:] ->
+ * -[_MTLBinaryArchive initWithOptions:device:url:error:] -> loadFromURL -> deserializeBinaryArchiveHeader), killing
+ * backboardd at every start (logs/gpu-ca-1625.log). The answer is an architecture no slice of Apple's is made for, so
+ * nothing precompiled matches and Metal keeps to the AIR, which this driver compiles. */
+#define HM_ARCH_CPU_TYPE 0x0100a642u     /* not a type of Apple's: the Adreno 642L */
+static id
+deviceTargetArchitecture(__unused id self, __unused SEL _cmd)
+{
+	static id arch;
+	static dispatch_once_t once;
+
+	dispatch_once(&once, ^{
+		Class c = NSClassFromString(@"MTLTargetDeviceArchitecture");
+		id a = c != Nil ? [[c alloc] init] : nil;
+
+		if (a != nil) {
+			((void (*)(id, SEL, unsigned int))objc_msgSend)(a, sel_getUid("setCpuType:"), HM_ARCH_CPU_TYPE);
+			((void (*)(id, SEL, unsigned int))objc_msgSend)(a, sel_getUid("setSubType:"), 0);
+			((void (*)(id, SEL, unsigned long long))objc_msgSend)(a, sel_getUid("setDriverVersion:"), 0);
+		}
+		arch = a;
+	});
+	return arch;
+}
+
+/* (darwin-lisa) a binary archive holds code for Apple's GPUs: none is made here */
+static id
+deviceNewBinaryArchive(__unused id self, __unused SEL _cmd, __unused id descriptor, NSError **error)
+{
+	if (error != NULL) {
+		*error = [NSError errorWithDomain:@"MTLBinaryArchiveDomain" code:1
+					 userInfo:@{ NSLocalizedDescriptionKey: @"binary archives are not supported by this device" }];
+	}
+	return nil;
+}

 /* ---- bringing it up ---- */
 
+/*
+ * darwin-lisa: the root's APFS container (its superblock at block 0 of part) ends at or before block first. Read
+ * through the loader or this kernel's driver like any read; "NXSB" at 32, the block size at 36, the count at 40.
+ */
+static const char *
+ufs_root_below_why(uint32_t part, uint64_t first)
+{
+	uint8_t *b = kalloc_data(4096, Z_WAITOK);
+	const char *why = NULL;
+
+	if (b == NULL || ufs_read(part, 0, b, 4096) != 0) {
+		why = "its block 0 could not be read";
+	} else if (memcmp(b + 32, "NXSB", 4) != 0) {
+		why = "no APFS container (the root) at its block 0";
+	} else if (*(uint32_t *)(b + 36) != 4096 || *(uint64_t *)(b + 40) == 0 || *(uint64_t *)(b + 40) > first) {
+		printf("ufs: the root container has %llu blocks of %u; the region begins at %llu\n",
+		    *(uint64_t *)(b + 40), *(uint32_t *)(b + 36), first);
+		why = "the root container reaches into the region";
+	}
+	if (b != NULL) {
+		kfree_data(b, 4096);
+	}
+	return why;
+}
+
+static void
+ufs_data_init(void)
+{
+	uint32_t offered = ufs_page->write_part_plus_one, part = BLOCK_MAX_PARTS;
+	uint64_t first = 0, end = ufs_page->write_end;
+	const char *why = NULL;
+
+	(void)PE_parse_boot_arg_str("ufs_data", ufs_data_name, sizeof(ufs_data_name));
+	(void)PE_parse_boot_argn("ufs_write_first", &first, sizeof(first));
+	(void)PE_parse_boot_argn("ufs_data_restore_ms", &ufs_restore_ms, sizeof(ufs_restore_ms));
+	if (ufs_data_name[0] == 0) {
+		why = "no ufs_data=NAME says which partition the region is in";
+	} else if ((part = ufs_entry_unique(ufs_data_name)) == BLOCK_MAX_PARTS) {
+		why = "no partition of that name, or more than one";
+	} else if (ufs_no_loader) {
+		why = "ufs_loader=0: every write goes through the loader";
+	} else if (ufs_page->part[part].unit != 0) {
+		/* the first unit UEFI lists, which this kernel's own driver reads as LUN 0 and
+		 * has compared with the loader's reads; the device path this firmware gives
+		 * says no logical unit number at all, so part[].lun is 0xff for every unit */
+		why = "it is not on the first logical unit";
+	} else if (ufs_page->part[part].block_size != 4096) {
+		why = "its blocks are not 4096 bytes";
+	} else if (offered != part + 1) {
+		why = "the loader does not offer it for writes (ufs_write=1 ufs_data=NAME on its command line too, and a "
+		    "loader with that region in data-regions.h)";
+	} else if (end == 0) {
+		why = "the loader offers no end to the region (a loader without data-region.patch)";
+	} else if ((first = MAX(first, ufs_page->write_first)) >= end || end > ufs_page->part[part].blocks) {
+		why = "the region is empty or past the partition's end";
+	} else if (ufs_part_name[0] != 0 && strcmp(ufs_part_name, ufs_data_name) == 0) {
+		/* the root's own partition: the root lies at block 0, so a floor, and the container below it */
+		why = first == 0 ? "it is the root's partition and the region begins at its block 0" :
+		    ufs_root_below_why(part, first);
+	}
+	if (why != NULL) {
+		printf("ufs: ufs_data=%s: no write will be asked for: %s; everything of the storage is read only\n",
+		    ufs_data_name[0] != 0 ? ufs_data_name : "(none)", why);
+		return;
+	}
+	ufs_write_first = first;
+	ufs_write_end = end;
+	ufs_write_part = (int)part;
+	ufs_restore_call = thread_call_allocate(ufs_restore_fire, NULL);
+	printf("ufs: %s: blocks %llu..%llu (%llu MB, LBA %llu..%llu of unit 0) take writes as /dev/ufs_data; everything "
+	    "else of the storage is read only\n", ufs_data_name, first, end - 1, (end - first) * 4096 >> 20,
+	    ufs_page->part[part].start_lba + first, ufs_page->part[part].start_lba + end - 1);
+	if (devfs_make_node(makedev(ufs_bmajor, UFS_DATA_MINOR), DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640,
+	    "ufs_data") != NULL) {
+		printf("ufs: /dev/ufs_data: %s\n", ufs_data_op() == BLOCK_OP_WRITE_FAST ?
+		    "writes flushed when the file system asks" : "every write flushed and read back (an older loader)");
+	}
+}

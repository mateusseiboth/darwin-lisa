--- a/bsd/kern/mach_loader.c	2026-11-09 11:06:27.855260031 -0400
+++ b/bsd/kern/mach_loader.c	2026-11-09 11:06:27.866088401 -0400
@@ -2189,6 +2189,41 @@
 
 #define APPLE_UNPROTECTED_HEADER_SIZE   (3 * 4096)
 
+/*
+ * darwin-lisa: a text_crypter that strips pointer authentication from an
+ * arm64e code page as it is paged in, so iOS 26 runs unchanged from its sealed
+ * volumes on this CPU without PAC. The in-place rewriter is pac_rewrite.c; the
+ * instructions it cannot rewrite are emulated at EL0 (pac_emulate.c).
+ */
+extern size_t pac_rewrite_buffer(uint32_t *words, size_t count);
+
+static int
+pac_page_transform(const void *src, void *dst, unsigned long long src_offset __unused,
+    void *ops __unused)
+{
+	memcpy(dst, src, 4096);
+	pac_rewrite_buffer((uint32_t *)dst, 4096 / sizeof(uint32_t));
+	return 0;
+}
+
+static load_return_t
+pac_protect_segment(vm_map_t map, vm_map_offset_t map_addr, vm_map_size_t map_size)
+{
+	struct pager_crypt_info crypt_info;
+	kern_return_t kr;
+
+	if (map_size == 0) {
+		return LOAD_SUCCESS;
+	}
+	crypt_info.page_decrypt = pac_page_transform;
+	crypt_info.crypt_ops = NULL;
+	crypt_info.crypt_end = NULL;
+	kr = vm_map_apple_protected(map, map_addr, map_addr + map_size,
+	    (vm_object_offset_t)-1 /* use the map entry's own offset */,
+	    &crypt_info, CRYPTID_APP_ENCRYPTION);
+	return (kr == KERN_SUCCESS) ? LOAD_SUCCESS : LOAD_FAILURE;
+}

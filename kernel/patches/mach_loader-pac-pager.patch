+	    filetype == MH_DYLINKER)) {   /* darwin-lisa: dyld is arm64e even under an arm64 program */
+		ret = pac_protect_segment(map, vm_start, vm_end - vm_start);
+		if (ret != LOAD_SUCCESS) {
+			DEBUG4K_ERROR("pac_protect 0x%llx 0x%llx ret %d\n", (uint64_t)vm_start, (uint64_t)vm_end, ret);
+			return ret;
+		}
+	}
+#endif /* CONFIG_CODE_DECRYPTION */

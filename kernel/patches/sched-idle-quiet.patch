+/*
+ * darwin-lisa (sched-idle-quiet.patch): the small cores sleep when idle, the big ones poll.
+ *
+ * The idle loop polls on every core (cpu-idle-no-wfi.patch: WFI did not wake on the single-core bring-up kernel).
+ * Since the GIC v3 and Group-1 vtimer fixes it does (host run cpu-wfi1, 2026-11-11: wfi=1, cpus=7, 340 s, no hang),
+ * and three A55s polling for nothing cost the A78s: every turn of the loop re-read the pset's and the clutch's lines
+ * the A78s write on every enqueue (each such write then had to take them back) and did two atomics on one global
+ * counter (machine_track_platform_idle, now once per idle period), with the A55s at their top clock all along.
+ *
+ * Boot-arg idle_wfi_mask=MASK (default 0x70, cpu4-6 = the A55s; 0 = every core polls, as before): those cores wait
+ * in WFI when idle; an IPI or their timer wakes them. The A78s keep polling: the window server's threads are on them
+ * and they answer a wakeup at once. wfi=1 still puts every core to sleep. A core that leaves a head of the band to
+ * the A78s (lisa_hold, sched-prefer-select.patch) polls while it holds, so its wait stays bounded.
+ */
+TUNABLE(uint64_t, lisa_idle_wfi_mask, "idle_wfi_mask", 0x70);
+
+/* whether the core polls this turn of its idle loop (it holds a head of the band); written only by that core */
+static struct {
+	bool poll;
+} __attribute__((aligned(64))) lisa_idle_cpu[MAX_CPUS];
+
+static inline void
+lisa_idle_mark(int cpu, bool poll)
+{
+	if (lisa_idle_cpu[cpu].poll != poll) {
+		lisa_idle_cpu[cpu].poll = poll;
+	}
+}
+
+/* for cpu_idle (arm64/cpu.c): whether this core waits in WFI now; wfi_all is the wfi boot-arg */
+bool dlisa_idle_wfi(int cpu, unsigned int wfi_all);
+
+bool
+dlisa_idle_wfi(int cpu, unsigned int wfi_all)
+{
+	return !lisa_idle_cpu[cpu].poll && (wfi_all != 0 || ((lisa_idle_wfi_mask >> cpu) & 1) != 0);
+}

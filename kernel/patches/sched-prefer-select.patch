+/* for hakios.cpufreq.c (BSD sees thread_t opaque): the thread's priority, RT marked */
+int dlisa_thread_sched_pri(thread_t thread, bool *rt);
+
+int
+dlisa_thread_sched_pri(thread_t thread, bool *rt)
+{
+	*rt = thread->sched_mode == TH_MODE_REALTIME;
+	return thread->sched_pri;
+}

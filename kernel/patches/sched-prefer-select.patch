+/* "tl: sp held N late N hand N move N pull N", the counts since the last call; empty when nothing changed */
+void dlisa_sched_prefer_line(char *line, size_t size);
+
+void
+dlisa_sched_prefer_line(char *line, size_t size)
+{
+	static uint64_t before[5];
+	uint64_t now[5] = { dlisa_sp_held, dlisa_sp_late, dlisa_sp_hand, dlisa_sp_move, dlisa_sp_pull };
+	uint64_t delta[5];
+	bool changed = false;
+
+	for (int i = 0; i < 5; i++) {
+		delta[i] = now[i] - before[i];
+		changed |= delta[i] != 0;
+		before[i] = now[i];
+	}
+	line[0] = 0;
+	if (changed) {
+		snprintf(line, size, "tl: sp held %llu late %llu hand %llu move %llu pull %llu", (unsigned long long)delta[0],
+		    (unsigned long long)delta[1], (unsigned long long)delta[2], (unsigned long long)delta[3],
+		    (unsigned long long)delta[4]);
+	}
+}

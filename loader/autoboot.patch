+/*
+ * The auto-boot wait is over and no host spoke: run the payload the loader came with, as "oem run" does. When that
+ * run ends with still no host, restart after AUTOBOOT_RESTART_SECONDS (a host that speaks meanwhile keeps the
+ * loader). Called with autoboot_deadline set and expired.
+ */
+#define AUTOBOOT_RESTART_SECONDS 10
+
+static void
+autoboot_fire(void)
+{
+	uint64_t freq = READ_SYSREG(CNTFRQ_EL0);
+
+	if (autoboot_host_spoke) {
+		autoboot_deadline = 0;
+		return;
+	}
+	if (autoboot_restart_pending) {
+		/* the restart wait after an auto-booted run is over */
+		print("autoboot: no host after the run: restarting\n");
+		flush_log();
+		BS->stall(200000);
+		ST->rt->reset_system(0 /* EfiResetCold */, 0, 0, NULL);
+		return;
+	}
+	autoboot_deadline = 0;
+	set_result("running", 0, 0);
+	log_len = 0;
+	print("== XNULOADER run (autoboot: no host) ==\n");
+	if (!run_kernel(0, 0)) {
+		set_result("not-started", 0, 0);
+		compose_logs(NULL, 0);
+	}
+	if (autoboot_host_spoke) {
+		return;         /* a host came during the run: the loader is its */
+	}
+	/* the next expiry restarts instead of running again: a second run in one session does not work */
+	print("autoboot: the run is over (%s): restarting in %d s unless a host speaks\n", last_result,
+	    (uint64_t)AUTOBOOT_RESTART_SECONDS);
+	autoboot_restart_pending = 1;
+	autoboot_deadline = READ_SYSREG(CNTVCT_EL0) + AUTOBOOT_RESTART_SECONDS * freq;
+}
+
 static void

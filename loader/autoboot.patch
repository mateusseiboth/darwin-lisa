  */
 static uint64_t usb_data_timeout;
 
+/*
+ * darwin-lisa autoboot (loader/autoboot.patch): a payload with "usb" and "autoboot=N" is the phone's own boot, with
+ * no PC. The loader comes up for the host as always, and if no fastboot command arrives within N seconds it runs
+ * the payload it came with, as "oem run" would: same watching core, same watchdog, USB still up for a host that
+ * plugs in later. The first command from a host cancels it for the rest of the session, so the host-driven flow
+ * (bootos.sh, run-*.sh) is what it was. When an auto-booted run ends and no host has spoken, the phone restarts
+ * (U-Boot's menu, then this again), so it never sits in the loader with nobody to talk to it.
+ */
+static uint64_t autoboot_deadline;      /* CNTVCT at which the wait ends; 0: no auto-boot pending */
+static int autoboot_host_spoke;         /* a host sent a command in this session */
+static int autoboot_restart_pending;    /* the auto-booted run is over: the next expiry restarts the phone */
+#define AUTOBOOT_EXPIRED        (-2)    /* usb_wait(): the auto-boot wait is over */
+
+static int
+autoboot_expired(void)
+{
+	return autoboot_deadline != 0 && READ_SYSREG(CNTVCT_EL0) >= autoboot_deadline;
+}

+/*
+ * A region with root_below: the root's APFS container superblock at the partition's block 0 (read
+ * here, before the kernel runs, into the block buffer nothing else uses yet), and the container no
+ * longer than write_first. Its magic "NXSB" at 32, its block size at 36, its block count at 40.
+ */
+static const char *
+block_root_below_why(efi_block_io *bio, const struct block_region *r)
+{
+	const uint8_t *b = block_buffer;
+	uint32_t bs;
+	uint64_t nb;
+
+	if (EFI_ERROR(bio->read_blocks(bio, bio->media->media_id, 0, 4096, block_buffer))) {
+		return "its block 0 could not be read";
+	}
+	flush_dcache((uint64_t)(uintptr_t)block_buffer, (uint64_t)(uintptr_t)block_buffer + 4096);
+	if (b[32] != 'N' || b[33] != 'X' || b[34] != 'S' || b[35] != 'B') {
+		return "no APFS container (the root) at its block 0";
+	}
+	bs = (uint32_t)b[36] | (uint32_t)b[37] << 8 | (uint32_t)b[38] << 16 | (uint32_t)b[39] << 24;
+	nb = 0;
+	for (int i = 7; i >= 0; i--) {
+		nb = nb << 8 | b[40 + i];
+	}
+	if (bs != 4096 || nb == 0 || nb > r->write_first) {
+		print("ufs: %s: the root container has %d blocks of %d; the writable stretch begins at %d\n", r->name, nb,
+		    (uint64_t)bs, r->write_first);
+		return "the root container reaches into the writable stretch";
+	}
+	return NULL;
+}

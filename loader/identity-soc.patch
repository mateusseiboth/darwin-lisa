 #include "identity.h"         /* who Darwin shall think we are: from the iPhone's own device tree (mkidentity.py) */
+/*
+ * darwin-lisa (loader/identity-soc.patch): the SoC and the board of that same iPhone, which iBoot fills in on a real
+ * phone and its device tree leaves at zero. An identity header with them (darwin-lisa/loader/identity-soc.py) gives
+ * its own; one without keeps the iPhone X's, as this loader always wrote. Our kernel only hashes chip-id into
+ * IOPlatformUUID (IOPlatformExpert.cpp); its own platform is /arm-io's device_type (PLAT->name), which stays.
+ */
+#ifndef IDENTITY_PLATFORM_NAME
+#define IDENTITY_PLATFORM_NAME     "t8015"
+#define IDENTITY_CHIP_ID           0x8015
+#define IDENTITY_BOARD_ID          0x06
+#define IDENTITY_REGULATORY_MODEL  "A1865"
+#endif
 
 /* ------------------------------------------------------------------------ */

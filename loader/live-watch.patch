+/*
+ * darwin-lisa (loader/live-watch.patch): what says that the kernel on the other core is alive.
+ *
+ * A standalone boot (2026-11-10) had iOS on its lock screen, its clock going from 4:00 to 4:01, while this loader
+ * called the kernel hung ("no sign of life for 50 seconds"), left its watch loop and with it the kernel's storage:
+ * iOS, whose root is read through this loader, then stalled for good. The kernel had logged some 125 KB more in
+ * those 50 seconds (191810 bytes at 24 s, about 316 KB in the log of the "hang"). The heartbeat it was judged by
+ * was the one word of the kernel's that this core read without looking at memory: XNU maps its memory Outer
+ * Shareable, U-Boot maps the same memory Inner Shareable, and with mismatched shareability the architecture does not
+ * promise that one core sees another's writes through its cache. Up to NOTE_SECONDS the progress notes and the log
+ * writes evict that line every 2 s; after them the watch loop is small enough to keep reading one stale copy. Every
+ * other word the kernel writes (its log's length, its storage requests) was already read through memory.
+ *
+ * So the kernel's signs of life are read through memory (dc civac first, as for the storage mailbox), and there are
+ * four of them: the heartbeat, the log's length, where its ring is written, and the last storage request. Any one of
+ * them moving is life. Silence for SILENCE_SECONDS is only a suspicion: it is written down with the kernel's log so
+ * far (logdump), and the loader goes on watching, feeding the watchdog, answering the host and serving the storage.
+ * Only after loader_hang_after= seconds of silence of all four (default HANG_SECONDS; 0: never) is the run given up,
+ * and even then the storage is still served from the command loop while the kernel holds its core: a kernel that
+ * asks for a block after that is alive, and an auto-boot's restart is called off.
+ */
+#define HANG_SECONDS            600
+#define SUSPICIONS_LOGGED       3       /* a kernel that goes quiet and comes back again and again: so many written down */
+
+struct live_signs {
+	uint64_t heartbeat;
+	uint32_t log_len, log_ring_at;
+	uint32_t request;               /* the kernel's last storage request (block_shared.ask.request) */
+};
+
+static uint64_t hang_after = HANG_SECONDS;      /* loader_hang_after= on the command line */
+static int kernel_left_on_core;                 /* a run was given up for hung: the kernel may still be on its core */
+
+/* written by another core: look at memory, not at what this core's cache kept of it */
+static uint64_t
+read_through(const volatile void *p, uint64_t size)
+{
+	uint64_t a = (uint64_t)(uintptr_t)p;
+
+	flush_dcache(a, a + size);
+	return size == 8 ? *(const volatile uint64_t *)p : *(const volatile uint32_t *)p;
+}
+
+static void
+read_live_signs(const struct kernel_live *live, uint64_t slide, struct live_signs *s)
+{
+	s->heartbeat = read_through(&live->heartbeat, 8);
+	s->log_len = (uint32_t)read_through((const void *)(uintptr_t)(live->log_len + slide), 4);
+	s->log_ring_at = (uint32_t)read_through((const void *)(uintptr_t)(live->log_ring_at + slide), 4);
+	s->request = block_enabled ? (uint32_t)read_through(&block_shared.ask.request, 4) : 0;
+}
+
+static int
+live_signs_moved(const struct live_signs *now, const struct live_signs *then)
+{
+	return now->heartbeat != then->heartbeat || now->log_len != then->log_len ||
+	       now->log_ring_at != then->log_ring_at || now->request != then->request;
+}
+
+/* the loader's log and the kernel's so far into logdump, without moving anything under the kernel's feet */
+static void
+save_live_log(const struct kernel_live *live, uint64_t slide)
+{
+	efi_block_io *bio = find_log_partition();
+	uint64_t len;
+	efi_status ws;
+
+	compose_live_log(live, slide);
+	if (bio == NULL || !hc_list_is_uefis()) {
+		return;         /* (staged all the same: "fastboot get_staged" has it) */
+	}
+	len = (staged_len + bio->media->block_size - 1) / bio->media->block_size * bio->media->block_size;
+	ws = bio->write_blocks(bio, bio->media->media_id, 0, len, out_buf);
+	if (!EFI_ERROR(ws)) {
+		bio->flush_blocks(bio);
+	}
+	print("log: the loader's and the kernel's so far, %d bytes, written to logdump (%x)\n", len, ws);
+}

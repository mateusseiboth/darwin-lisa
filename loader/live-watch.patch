+/*
+ * The command loop (live-watch.patch): a kernel given up for hung still holds its core, and its storage is served all
+ * the same. One that asks for a block after that is alive: an auto-boot's restart is called off.
+ */
+static void
+serve_left_kernel(void)
+{
+	static int said;
+	uint64_t before;
+
+	if (!kernel_left_on_core || !block_enabled) {
+		return;
+	}
+	before = block_shared.answer.served + block_shared.answer.failed;
+	block_poll();
+	if (block_shared.answer.served + block_shared.answer.failed == before) {
+		return;
+	}
+	if (!said) {
+		said = 1;
+		print("the kernel taken for hung asked for its storage: it is alive; served, and no restart\n");
+	}
+	autoboot_restart_pending = 0;
+	autoboot_deadline = 0;
+}

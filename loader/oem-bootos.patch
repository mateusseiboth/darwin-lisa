 /*
+ * "fastboot oem bootos:TARGET": the host picks what U-Boot starts next, with no button pressed.
+ *
+ * No reset is involved, so nothing has to survive one (every reset on lisa is a PMIC hard reset, ABL's log says
+ * "Reset Type: Hard Reset"). The loader leaves a one-shot request in the last page of its payload window, which the
+ * device tree keeps reserved (hakios-payload@f0000000) and nothing else uses, gives the USB controller and the
+ * watchdog back the way it found them, and exits to U-Boot; U-Boot's osel_check (board/qualcomm/hakios-lisa.env)
+ * reads the request, clears it and runs the target. Only before any kernel has run in this session: a kernel leaves
+ * the hardware as it pleases, and then "fastboot reboot" first gives a fresh session.
+ */
+#define OSEL_ADDR           (PAYLOAD_BASE + PAYLOAD_MAX_SIZE - 0x1000ULL)  /* 0xf3fff000: U-Boot's osel_addr */
+#define OSEL_MAGIC          0x4c45534fu                                    /* "OSEL" */
+
+static int kernel_was_run;      /* "oem run"/"oem selftest" happened in this session */
+
+static void
+osel_write(uint32_t code)
+{
+	volatile uint32_t *osel = (volatile uint32_t *)(uintptr_t)OSEL_ADDR;
+
+	osel[0] = code != 0 ? OSEL_MAGIC : 0;
+	osel[1] = code;
+	osel[2] = ~code;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* U-Boot's osel_N: 1 postmarketOS, 2 the UFS as a USB disk, 3 U-Boot's fastboot, 4 U-Boot's menu; 0: none */
+static uint32_t
+bootos_code(const char *target)
+{
+	static const char *const names[] = { "pmos", "ums", "uboot", "menu" };
+
+	for (uint32_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (str_eq(target, names[i])) {
+			return i + 1;
+		}
+	}
+	return 0;
+}
+
+static void
+uninstall_exception_hook(void)
+{
+	static const efi_guid cpu_guid = EFI_CPU_ARCH_GUID;
+	efi_cpu_arch *cpu;
+
+	if (EFI_ERROR(BS->locate_protocol(&cpu_guid, NULL, (void **)&cpu))) {
+		return;
+	}
+	for (int64_t type = 0; type <= 3; type += 3) {
+		cpu->register_interrupt_handler(cpu, type, NULL);
+	}
+}
+

+/*
+ * Before the loader exits to U-Boot: the watchdog back off, as the loader found it (status ctl=0 at every start on
+ * lisa), since nothing after U-Boot pets it. Control 2 keeps it configured and disabled (Linux hh_virt_wdt: 3 enables,
+ * 2 disables); 0 is the state it is found in. Returns 1 when the hypervisor reports it stopped, else re-arms it and
+ * returns 0, so a loader that could not stop it never leaves.
+ */
+static int
+wdt_release(void)
+{
+	uint64_t ctl = 1, since = 0;
+
+	if (!wdt_armed) {
+		return 1;
+	}
+	smc_call(VIRT_WDT_CONTROL, 2, 0, NULL, NULL);
+	if (smc_call(VIRT_WDT_STATUS, 0, 0, &ctl, &since) != 0 || (ctl & 1) != 0) {
+		smc_call(VIRT_WDT_CONTROL, 0, 0, NULL, NULL);
+		ctl = 1;
+		if (smc_call(VIRT_WDT_STATUS, 0, 0, &ctl, &since) != 0 || (ctl & 1) != 0) {
+			smc_call(VIRT_WDT_CONTROL, 3, 0, NULL, NULL);
+			wdt_set_ms(WDT_BITE_MS);
+			print("watchdog: would not stop (ctl=%x): staying in the loader\n", ctl);
+			return 0;
+		}
+	}
+	print("watchdog: stopped (ctl=%x) for U-Boot\n", ctl);
+	wdt_armed = 0;
+	return 1;
+}
